# Gmail SMTP Configuration
# To use Gmail SMTP, you need to:
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use that App Password below (NOT your regular Gmail password)

GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
RECEIVER_EMAIL=sherpa.sjs@gmail.com
PORT=3001

# Optional: Google reCAPTCHA v3 Secret Key
# Get one from: https://www.google.com/recaptcha/admin
# Leave empty to disable reCAPTCHA verification
RECAPTCHA_SECRET_KEY=
