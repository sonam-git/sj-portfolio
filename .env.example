# Frontend Environment Variables

# Optional: Google reCAPTCHA v3 Site Key
# Get one from: https://www.google.com/recaptcha/admin
# Leave empty to disable reCAPTCHA protection
VITE_RECAPTCHA_SITE_KEY=

# Optional: Custom API URL (for local development with different port)
# Leave empty to use default (localhost:3001 for dev, relative for prod)
VITE_API_URL=
